POSTGRES_PASSWORD=local-development-change-before-deploy
DATABASE_URL=postgresql+psycopg://lectureloop:local-development-change-before-deploy@db:5432/lectureloop
APP_ORIGIN=http://localhost:8080
SITE_ADDRESS=:80
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536
OPENAI_LIVE_STT_MODEL=gpt-live-transcribe
OPENAI_BATCH_STT_MODEL=gpt-transcribe
MAX_UPLOAD_MB=100

# Retrieval and preflight budgets; retrieval + optional generation <= 30 seconds.
RETRIEVAL_TIMEOUT_SECONDS=20
QUERY_EMBEDDING_TIMEOUT_SECONDS=10
ANSWER_TIMEOUT_SECONDS=10
# Worker models/tokenizer are provisioned into its image, not fetched during OCR.
OCR_MODEL_ROOT=/opt/lectureloop/models
