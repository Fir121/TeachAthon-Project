FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libreoffice-impress libreoffice-writer libmagic1 fonts-dejavu && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock
COPY apps/api/ .
RUN useradd -m -u 10001 lectureloop && mkdir -p /media && chown lectureloop:lectureloop /media
USER lectureloop
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
