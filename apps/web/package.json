{
  "name": "lectureloop-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:pdf && vite --host 0.0.0.0",
    "build": "npm run prepare:pdf && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src public *.ts *.json index.html",
    "format:check": "prettier --check src public *.ts *.json index.html",
    "prepare:pdf": "node scripts/prepare-pdf.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
